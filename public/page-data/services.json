      "html": "<div data-v-d1e1d890><section id=\"section-services-hero\" class=\"px-gutter max-md:px-gutter-mobile flex flex-col mx-auto w-full relative justify-center pb-8 max-md:pb-4 section-shell--nav-clearance section-shell--nav-clearance-with-padding section-shell--fluid-mobile-padding pointer-events-auto\" style=\"--section-shell-padding-top:10rem;--section-shell-padding-top-mobile:10rem;\" data-v-d1e1d890 data-v-1c6297c3><div class=\"flex w-full flex-col gap-8\" data-v-d1e1d890><div class=\"page-intro__measure--narrow flex flex-col gap-4\" data-v-d1e1d890><p class=\"text-spark max-md:text-base max-md:leading-6 text-lg font-normal leading-none tracking-tight\" data-v-d1e1d890>Services</p><h1 class=\"font-normal tracking-tight max-md:text-5xl max-md:leading-none max-md:tracking-display text-6xl\" data-v-d1e1d890><span class=\"block text-slatecolor\">Growth strategy that gets your business seen.</span></h1></div></div></section></div>"
