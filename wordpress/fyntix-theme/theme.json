{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "spark",
          "color": "#f75d3b",
          "name": "Spark (Brand Orange)"
        },
        {
          "slug": "charcoal",
          "color": "#141414",
          "name": "Charcoal (Dark Gray)"
        },
        {
          "slug": "chalk",
          "color": "#ffffff",
          "name": "Chalk (White)"
        },
        {
          "slug": "slatecolor",
          "color": "#262626",
          "name": "Slatecolor"
        },
        {
          "slug": "haze-60",
          "color": "rgba(255, 255, 255, 0.6)",
          "name": "Haze 60%"
        },
        {
          "slug": "haze-300",
          "color": "#e0e0e0",
          "name": "Haze 300"
        },
        {
          "slug": "haze-800",
          "color": "#6f6f6f",
          "name": "Haze 800"
        },
        {
          "slug": "haze-900",
          "color": "#1a1a1a",
          "name": "Haze 900"
        },
        {
          "slug": "soft-grey",
          "color": "#f8f8f8",
          "name": "Soft Grey"
        },
        {
          "slug": "ember",
          "color": "#dc2626",
          "name": "Ember (Error Red)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "'Inter Display', sans-serif",
          "slug": "inter-display",
          "name": "Inter Display"
        },
        {
          "fontFamily": "'Instrument Serif', serif",
          "slug": "instrument-serif",
          "name": "Instrument Serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Small"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "1.25rem",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "1.5rem",
          "name": "2XL"
        },
        {
          "slug": "3xl",
          "size": "1.875rem",
          "name": "3XL"
        },
        {
          "slug": "4xl",
          "size": "2.25rem",
          "name": "4XL"
        },
        {
          "slug": "5xl",
          "size": "3rem",
          "name": "5XL"
        },
        {
          "slug": "6xl",
          "size": "3.75rem",
          "name": "6XL"
        },
        {
          "slug": "7xl",
          "size": "4.5rem",
          "name": "7XL"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "1.5rem",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "3rem",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "4rem",
          "name": "2XL"
        },
        {
          "slug": "3xl",
          "size": "6rem",
          "name": "3XL"
        },
        {
          "slug": "gutter",
          "size": "clamp(1.5rem, 5vw, 3rem)",
          "name": "Gutter"
        }
      ]
    },
    "layout": {
      "contentSize": "75rem",
      "wideSize": "90rem"
    },
    "custom": {
      "breakpoints": {
        "mobile": "767px",
        "tablet": "809px",
        "desktop": "1200px",
        "wide": "1920px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--chalk)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter-display)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--spark)"
        },
        ":hover": {
          "color": {
            "text": "#e14b2b"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--spark)",
          "text": "var(--wp--preset--color--chalk)"
        },
        "border": {
          "radius": "9999px"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.875rem",
            "right": "1.25rem",
            "bottom": "0.875rem",
            "left": "1.25rem"
          }
        },
        ":hover": {
          "color": {
            "background": "#e14b2b"
          }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "lineHeight": "1.6"
        }
      },
      "core/heading": {
        "typography": {
          "fontWeight": "400",
          "lineHeight": "1.1"
        }
      }
    }
  }
}
